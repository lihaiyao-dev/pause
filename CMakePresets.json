{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-tests",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "PAUSE_BUILD_TOOLCHAIN_SMOKE_TEST": "ON",
        "PAUSE_BUILD_TESTS": "ON",
        "PAUSE_BUILD_DESIGN_TESTS": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug tests (Ninja)",
      "inherits": "msvc-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG:FULL /INCREMENTAL:NO"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release tests (Ninja)",
      "inherits": "msvc-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-tests",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "msvc-tests",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "msvc-release",
      "inherits": "msvc-tests",
      "configurePreset": "msvc-release"
    }
  ]
}
