# Portable lifecycle/failure tests. All writes stay in a fresh OUTPUT_DIRECTORY.
cmake_minimum_required(VERSION 3.25)
if(NOT IS_ABSOLUTE "${OUTPUT_DIRECTORY}")
    message(FATAL_ERROR "Set -DOUTPUT_DIRECTORY=<absolute-directory>")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
string(APPEND OUTPUT_DIRECTORY "/run-${run_id}")
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(prefix "${OUTPUT_DIRECTORY}/installed with spaces")
set(package "${OUTPUT_DIRECTORY}/package")
file(MAKE_DIRECTORY "${package}/include" "${prefix}")
file(COPY "${source_root}/cmake/manage-pause.cmake" DESTINATION "${package}")
file(WRITE "${prefix}/unrelated.txt" "keep me")
file(WRITE "${package}/include/pause.hpp" "version one")
file(WRITE "${package}/obsolete.txt" "old payload")

function(manifest root)
    set(content "pause-package-v1|0.1.0\n")
    foreach(relative IN LISTS ARGN)
        file(SHA256 "${root}/${relative}" hash)
        string(APPEND content "${hash}|${relative}\n")
    endforeach()
    file(WRITE "${root}/pause-manifest.txt" "${content}")
endfunction()

function(run action expected pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DACTION=${action}" "-DPREFIX=${prefix}"
        -P "${package}/manage-pause.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
    string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${out}${err}")
    if((expected STREQUAL "pass" AND NOT result STREQUAL "0")
       OR (expected STREQUAL "fail" AND result STREQUAL "0")
       OR NOT diagnostic MATCHES "${pattern}")
        message(FATAL_ERROR "${action}: unexpected result ${result}: ${out}${err}")
    endif()
endfunction()

manifest("${package}" manage-pause.cmake include/pause.hpp obsolete.txt)
run(update fail "not installed")
run(install pass "completed")
run(install fail "already installed")
file(WRITE "${prefix}/include/pause.hpp" "local edit")
run(update fail "Modified or corrupt")
run(uninstall fail "Modified or corrupt")
file(READ "${prefix}/include/pause.hpp" actual)
if(NOT actual STREQUAL "local edit")
    message(FATAL_ERROR "Local edits were lost")
endif()
file(WRITE "${prefix}/include/pause.hpp" "version one")
file(WRITE "${package}/include/pause.hpp" "version two")
file(WRITE "${package}/new.txt" "new payload")
manifest("${package}" manage-pause.cmake include/pause.hpp new.txt)
file(WRITE "${prefix}/new.txt" "another owner")
run(update fail "unowned file")
file(READ "${prefix}/include/pause.hpp" actual)
if(NOT actual STREQUAL "version one")
    message(FATAL_ERROR "Conflict changed the installation")
endif()
file(REMOVE "${prefix}/new.txt")
run(update pass "completed")
if(EXISTS "${prefix}/obsolete.txt" OR NOT EXISTS "${prefix}/new.txt")
    message(FATAL_ERROR "Update did not reconcile obsolete/new files")
endif()
run(update pass "completed")
file(WRITE "${package}/include/pause.hpp" "corrupt archive")
run(update fail "Modified or corrupt")
file(WRITE "${package}/include/pause.hpp" "version two")
file(MAKE_DIRECTORY "${prefix}/.pause-transaction")
run(update fail "interrupted transaction")
# The exact empty transaction fixture is inside this test's fresh output root.
file(REMOVE_RECURSE "${prefix}/.pause-transaction")
run(uninstall pass "completed")
run(uninstall pass "already uninstalled")
if(EXISTS "${prefix}/include/pause.hpp" OR EXISTS "${prefix}/pause-manifest.txt"
   OR NOT EXISTS "${prefix}/unrelated.txt")
    message(FATAL_ERROR "Uninstall violated file ownership")
endif()
# A file in place of a destination directory must fail during preflight.
file(MAKE_DIRECTORY "${package}/blocked")
file(WRITE "${package}/blocked/child.txt" "payload")
file(WRITE "${prefix}/blocked" "another owner")
manifest("${package}" manage-pause.cmake include/pause.hpp blocked/child.txt)
run(install fail "ancestor is not a directory")
if(EXISTS "${prefix}/include/pause.hpp")
    message(FATAL_ERROR "Invalid ancestor changed the installation")
endif()
manifest("${package}" manage-pause.cmake include/pause.hpp)
# Malicious/inconsistent package inventory must not reach outside the prefix.
file(APPEND "${package}/pause-manifest.txt"
    "0123456789012345678901234567890123456789012345678901234567890123|../escape.txt\n")
run(install fail "Unsafe manifest path")
message(STATUS "Pause package manager lifecycle and failure tests passed")
