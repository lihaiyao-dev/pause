cmake_minimum_required(VERSION 3.25)

# Run from an extracted package (no source checkout or compiler required).
# cmake -DACTION=install|update|uninstall -DPREFIX=<absolute-prefix> -P manage-pause.cmake
if(NOT ACTION MATCHES "^(install|update|uninstall)$" OR NOT IS_ABSOLUTE "${PREFIX}")
    message(FATAL_ERROR "Use -DACTION=install|update|uninstall -DPREFIX=<absolute-directory>")
endif()
if(PREFIX MATCHES "[;\n\r]")
    message(FATAL_ERROR "PREFIX cannot contain list separators or newlines")
endif()
file(TO_CMAKE_PATH "${PREFIX}" PREFIX)
cmake_path(NORMAL_PATH PREFIX)
cmake_path(GET PREFIX ROOT_PATH filesystem_root)
if(PREFIX STREQUAL filesystem_root)
    message(FATAL_ERROR "Installing into a filesystem root is not supported")
endif()

function(check_path root relative)
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.?(/|$)|[;|:\\\\\n\r]"
       OR relative STREQUAL "")
        message(FATAL_ERROR "Unsafe manifest path: ${relative}")
    endif()
    set(candidate "${root}/${relative}")
    cmake_path(NORMAL_PATH candidate)
    set(leaf "${candidate}")
    cmake_path(IS_PREFIX root "${candidate}" NORMALIZE inside)
    if(NOT inside OR candidate STREQUAL root)
        message(FATAL_ERROR "Manifest path escapes its prefix: ${relative}")
    endif()
    # Check ancestors as well as the leaf, including junctions/symlinks outside
    # the selected prefix. These are developer-owned, non-adversarial prefixes.
    while(NOT candidate STREQUAL "")
        if(IS_SYMLINK "${candidate}")
            message(FATAL_ERROR "Refusing to follow a symlink: ${candidate}")
        endif()
        if(NOT candidate STREQUAL leaf AND EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
            message(FATAL_ERROR "A path ancestor is not a directory: ${candidate}")
        endif()
        cmake_path(GET candidate PARENT_PATH parent)
        if(parent STREQUAL candidate)
            break()
        endif()
        set(candidate "${parent}")
    endwhile()
endfunction()

function(read_manifest root output)
    check_path("${root}" pause-manifest.txt)
    file(STRINGS "${root}/pause-manifest.txt" lines ENCODING UTF-8)
    list(POP_FRONT lines header)
    if(NOT header MATCHES "^pause-package-v1\\|[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "Unknown or invalid Pause manifest: ${root}")
    endif()
    set(paths "")
    set(path_keys "")
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^([0-9a-f]+)\\|(.+)$")
            message(FATAL_ERROR "Malformed Pause manifest entry")
        endif()
        set(digest "${CMAKE_MATCH_1}")
        set(relative "${CMAKE_MATCH_2}")
        check_path("${root}" "${relative}")
        set(path_key "${relative}")
        cmake_path(NORMAL_PATH path_key)
        if(WIN32)
            string(TOLOWER "${path_key}" path_key)
            if(path_key MATCHES "[. ](/|$)")
                message(FATAL_ERROR "Ambiguous Windows manifest path: ${relative}")
            endif()
        endif()
        string(LENGTH "${digest}" digest_length)
        if(NOT digest_length EQUAL 64 OR path_key IN_LIST path_keys
           OR path_key MATCHES "^\\.pause" OR path_key STREQUAL "pause-manifest.txt")
            message(FATAL_ERROR "Invalid or duplicate Pause manifest entry: ${relative}")
        endif()
        if(NOT EXISTS "${root}/${relative}" OR IS_DIRECTORY "${root}/${relative}")
            message(FATAL_ERROR "Missing managed file: ${root}/${relative}")
        endif()
        file(SHA256 "${root}/${relative}" actual)
        if(NOT actual STREQUAL digest)
            message(FATAL_ERROR "Modified or corrupt file (no changes made): ${root}/${relative}")
        endif()
        list(APPEND paths "${relative}")
        list(APPEND path_keys "${path_key}")
    endforeach()
    if(NOT "manage-pause.cmake" IN_LIST paths)
        message(FATAL_ERROR "Incomplete Pause package manifest")
    endif()
    set(${output} "${paths}" PARENT_SCOPE)
endfunction()

set(package_root "${CMAKE_CURRENT_LIST_DIR}")
set(new_files "")
if(NOT ACTION STREQUAL "uninstall")
    read_manifest("${package_root}" new_files)
    # Refuse overlapping source and destination trees.
    cmake_path(IS_PREFIX package_root "${PREFIX}" NORMALIZE destination_inside_source)
    cmake_path(IS_PREFIX PREFIX "${package_root}" NORMALIZE source_inside_destination)
    if(destination_inside_source OR source_inside_destination)
        message(FATAL_ERROR "Extracted package and installation prefix must be separate trees")
    endif()
endif()

check_path("${PREFIX}" .pause.lock)
check_path("${PREFIX}" .pause-transaction)
file(MAKE_DIRECTORY "${PREFIX}")
file(LOCK "${PREFIX}/.pause.lock" GUARD PROCESS TIMEOUT 10 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Could not lock Pause prefix: ${lock_result}")
endif()
set(transaction "${PREFIX}/.pause-transaction")
if(EXISTS "${transaction}")
    message(FATAL_ERROR
        "An interrupted transaction exists at ${transaction}. Restore its backup before retrying; "
        "see packaging.md. No installed files were changed by this invocation.")
endif()
set(old_files "")
check_path("${PREFIX}" pause-manifest.txt)
if(EXISTS "${PREFIX}/pause-manifest.txt")
    read_manifest("${PREFIX}" old_files)
    if(ACTION STREQUAL "install")
        message(FATAL_ERROR "Pause is already installed; use ACTION=update")
    endif()
elseif(ACTION STREQUAL "update")
    message(FATAL_ERROR "Pause is not installed; use ACTION=install")
elseif(ACTION STREQUAL "uninstall")
    message(STATUS "Pause is already uninstalled")
    return()
endif()

foreach(relative IN LISTS new_files)
    check_path("${PREFIX}" "${relative}")
    if(EXISTS "${PREFIX}/${relative}" AND NOT relative IN_LIST old_files)
        message(FATAL_ERROR "Refusing to overwrite an unowned file: ${PREFIX}/${relative}")
    endif()
endforeach()
set(affected ${old_files} ${new_files} pause-manifest.txt)
list(REMOVE_DUPLICATES affected)

# Backup and stage before touching installed payload. Retain the transaction on
# an interrupted/failed rollback so the user has the exact original files.
file(MAKE_DIRECTORY "${transaction}/backup" "${transaction}/new")
file(WRITE "${transaction}/affected.txt" "${affected}")
set(backed_up ${old_files})
if(EXISTS "${PREFIX}/pause-manifest.txt")
    list(APPEND backed_up pause-manifest.txt)
endif()
foreach(relative IN LISTS backed_up)
    get_filename_component(parent "${transaction}/backup/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${PREFIX}/${relative}" "${transaction}/backup/${relative}")
endforeach()
file(WRITE "${transaction}/backup-complete.txt" "${backed_up}")
if(NOT ACTION STREQUAL "uninstall")
    foreach(relative IN LISTS new_files ITEMS pause-manifest.txt)
        get_filename_component(parent "${transaction}/new/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${package_root}/${relative}" "${transaction}/new/${relative}")
    endforeach()
endif()

function(rollback reason)
    foreach(relative IN LISTS affected)
        if(relative IN_LIST backed_up)
            file(COPY_FILE "${transaction}/backup/${relative}" "${PREFIX}/${relative}" RESULT result)
        else()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${PREFIX}/${relative}"
                RESULT_VARIABLE result)
        endif()
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${reason}; rollback failed for ${relative}. Backup retained at ${transaction}")
        endif()
    endforeach()
    # This exact path was checked to be under PREFIX and free of symlinks.
    file(REMOVE_RECURSE "${transaction}")
    message(FATAL_ERROR "${reason}; original installation restored")
endfunction()

file(WRITE "${transaction}/commit-started.txt" "${ACTION}")
if(NOT ACTION STREQUAL "uninstall")
    foreach(relative IN LISTS new_files ITEMS pause-manifest.txt)
        get_filename_component(parent "${PREFIX}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${transaction}/new/${relative}" "${PREFIX}/${relative}" RESULT result)
        if(NOT result STREQUAL "0")
            rollback("Could not install ${relative}: ${result}")
        endif()
    endforeach()
endif()
set(remove_files ${old_files})
if(ACTION STREQUAL "uninstall")
    list(APPEND remove_files pause-manifest.txt)
endif()
foreach(relative IN LISTS remove_files)
    if(NOT relative IN_LIST new_files)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${PREFIX}/${relative}"
            RESULT_VARIABLE result)
        if(NOT result STREQUAL "0")
            rollback("Could not remove ${relative}")
        endif()
    endif()
endforeach()
file(REMOVE_RECURSE "${transaction}")
message(STATUS "Pause ${ACTION} completed: ${PREFIX}")
# Empty directories and the persistent lock file are intentionally retained.
