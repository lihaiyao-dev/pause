{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pause: simple workflow (LLDB DAP)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-debug/pause_simple_workflow.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "Pause: build Debug examples",
      "preRunCommands": [
        "breakpoint set --name main"
      ]
    },
    {
      "name": "Pause: thread pool (LLDB DAP)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-debug/pause_thread_pool.exe",
      "args": [
        "${input:workerCount}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "Pause: build Debug examples",
      "preRunCommands": [
        "breakpoint set --name main"
      ]
    },
    {
      "name": "Pause: cancellation (LLDB DAP)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-debug/pause_cancellation.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "Pause: build Debug examples",
      "preRunCommands": [
        "breakpoint set --name main"
      ]
    },
    {
      "name": "Pause: sender pipeline (LLDB DAP)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/msvc-debug/pause_sender_workflow.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "Pause: build Debug examples",
      "preRunCommands": [
        "breakpoint set --name main"
      ]
    }
  ],
  "inputs": [
    {
      "id": "workerCount",
      "type": "pickString",
      "description": "Thread pool workers",
      "options": [
        "1",
        "2",
        "4"
      ],
      "default": "4"
    }
  ]
}
