{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pause: build Debug examples",
      "type": "process",
      "command": "${env:ComSpec}",
      "args": [
        "/d",
        "/c",
        "scripts\\build-debug-examples.cmd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": "build"
    }
  ]
}
